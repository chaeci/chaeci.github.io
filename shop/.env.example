# =============================================================================
# MONO ATELIER 백엔드 — 환경변수 예시 (.env.example)
# -----------------------------------------------------------------------------
# · 이 파일은 "이름만" 공개하는 예시입니다. 실제 값을 채운 .env 는 절대 커밋하지 마세요.
# · 실제 파일 위치 예: /etc/mono-atelier/mono-atelier.env  (권한 600, 소유자 서비스 계정)
# · systemd 예시의 EnvironmentFile= 경로와 맞추세요.
# =============================================================================

# ---------------------------------------------------------------- 애플리케이션
APP_ENV=production
APP_VERSION=1.9.16
APP_BASE_URL=https://shop.example.com
BIND_HOST=127.0.0.1
BIND_PORT=8000
LOG_LEVEL=info

# -------------------------------------------------------------------- 세션/인증
# openssl rand -base64 48  로 생성한 값을 넣으세요. 비우면 기동 실패로 처리할 것.
SESSION_SECRET=
SESSION_COOKIE_NAME=mono_session
SESSION_TTL_HOURS=72
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
CSRF_ENABLED=1

# 관리자 초기 계정 — 첫 배포 시에만 사용하고, 배포 직후 비밀번호를 바꾸고 이 값을 비우세요.
ADMIN_INIT_EMAIL=admin@mono.kr
ADMIN_INIT_PASSWORD=

# ------------------------------------------------------------------- 데이터베이스
# build_sqlite.py 로 생성한 SQLite 파일의 절대 경로
MONO_DB=/var/lib/mono-atelier/mono-atelier.db
DB_BUSY_TIMEOUT_MS=5000
DB_JOURNAL_MODE=WAL

# --------------------------------------------------------------- 토스페이먼츠
# 시크릿 키는 서버에만 존재해야 합니다. 프론트에는 클라이언트 키만 내려보냅니다.
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
TOSS_MODE=test
TOSS_CONFIRM_API=https://api.tosspayments.com/v1/payments/confirm
TOSS_CANCEL_API=https://api.tosspayments.com/v1/payments

# ------------------------------------------------------------------ 이메일 발송
# Resend / Brevo / SMTP 프록시 등. API 키는 서버에서만 사용합니다.
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=no-reply@example.com
MAIL_MODE=test

# --------------------------------------------------------------------- SMS 발송
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=
SMS_MODE=test

# ------------------------------------------------------------- 업로드 / 미디어
MEDIA_ROOT=/var/lib/mono-atelier/media
MEDIA_PUBLIC_BASE=/media
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_IMAGE_SIDE=2000
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,video/mp4

# -------------------------------------------------------- 레이트리밋 / 보안 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_TTL_SECONDS=300
OTP_MAX_TRIES=5
SIGNUP_MAX_PER_IP_PER_DAY=20
WRITE_MAX_PER_USER_PER_MINUTE=30
TRUST_PROXY=1
CORS_ORIGINS=https://chaeci.github.io,https://shop.example.com

# ------------------------------------------------------------- 감사 로그 / 백업
AUDIT_LOG_PATH=/var/log/mono-atelier/audit.log
BACKUP_DIR=/var/backups/mono-atelier
BACKUP_KEEP_DAYS=14

# ------------------------------------------------------------------ 기능 스위치
# 정적 데모 모드(서버 승인 없이 테스트 승인)를 켜지 마세요. 운영에서는 반드시 0.
ALLOW_DEMO_PAYMENT_FALLBACK=0
# 개발/내부망에서만 1. 화면에 인증번호를 노출합니다.
ALLOW_TEST_OTP_ECHO=0
